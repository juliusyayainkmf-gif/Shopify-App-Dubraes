{{ 'dubraes-contact-form.css' | asset_url | stylesheet_tag }}

<style>
  .dubraes-contact-form {
    --dubraes-ink: #171512;
    --dubraes-muted: #6e6860;
    --dubraes-border: #ded9d1;
    --dubraes-cream: #f5f1e9;
    max-width: 1200px;
    margin: 48px auto;
    padding: 0 20px;
    color: var(--dubraes-ink);
  }

  .dubraes-contact-form__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    overflow: hidden;
    border-radius: 20px 20px 0 0;
    background: var(--dubraes-cream);
  }

  .dubraes-contact-form__visual {
    min-height: 420px;
  }

  .dubraes-contact-form__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dubraes-contact-form__intro-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 6vw, 72px);
  }

  .dubraes-contact-form__eyebrow {
    margin: 0 0 12px;
    color: #8f2f2b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .dubraes-contact-form__heading {
    max-width: 560px;
    margin: 0 0 18px;
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1.02;
  }

  .dubraes-contact-form__text {
    max-width: 560px;
    color: var(--dubraes-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .dubraes-contact-form__steps {
    display: grid;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
  }

  .dubraes-contact-form__steps li {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .dubraes-contact-form__steps span {
    color: #8f2f2b;
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  .dubraes-contact-form__panel {
    padding: clamp(28px, 5vw, 64px);
    border: 1px solid var(--dubraes-border);
    border-top: 0;
    border-radius: 0 0 20px 20px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(41, 35, 27, 0.08);
  }

  .dubraes-contact-form__panel-heading {
    margin-bottom: 28px;
  }

  .dubraes-contact-form__panel-heading h3 {
    margin: 0;
    font-size: clamp(24px, 3vw, 36px);
  }

  .dubraes-contact-form__form,
  .dubraes-contact-form__field {
    display: grid;
    gap: 20px;
  }

  .dubraes-contact-form__field {
    gap: 6px;
  }

  .dubraes-contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .dubraes-contact-form__field label {
    font-size: 14px;
    font-weight: 600;
  }

  .dubraes-contact-form__field input,
  .dubraes-contact-form__field textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--dubraes-border);
    border-radius: 9px;
    background: #fff;
    color: var(--dubraes-ink);
    font: inherit;
  }

  .dubraes-contact-form__field input:focus,
  .dubraes-contact-form__field textarea:focus {
    border-color: #8f2f2b;
    outline: none;
    box-shadow: 0 0 0 3px rgba(143, 47, 43, 0.12);
  }

  .dubraes-contact-form__upload {
    padding: 18px;
    border: 1px dashed #c8bfb2;
    border-radius: 12px;
    background: #faf8f4;
  }

  .dubraes-contact-form__field small,
  .dubraes-contact-form__actions p {
    color: var(--dubraes-muted);
  }

  .dubraes-contact-form__honeypot {
    position: absolute;
    left: -10000px;
    height: 1px;
    overflow: hidden;
  }

  .dubraes-contact-form__button {
    width: fit-content;
    padding: 14px 24px;
    border: 0;
    border-radius: 999px;
    background: var(--dubraes-ink);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .dubraes-contact-form__button:hover {
    background: #8f2f2b;
  }

  .dubraes-contact-form__button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .dubraes-contact-form__status[data-state="success"] {
    color: #176b35;
  }

  .dubraes-contact-form__status[data-state="error"] {
    color: #b42318;
  }

  .dubraes-contact-form__actions {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .dubraes-contact-form__actions p {
    margin: 0;
    font-size: 13px;
  }

  @media screen and (max-width: 850px) {
    .dubraes-contact-form__intro {
      grid-template-columns: 1fr;
    }

    .dubraes-contact-form__visual {
      min-height: 300px;
      max-height: 460px;
    }
  }

  @media screen and (max-width: 600px) {
    .dubraes-contact-form {
      margin: 24px auto;
      padding: 0 12px;
    }

    .dubraes-contact-form__row {
      grid-template-columns: 1fr;
    }

    .dubraes-contact-form__actions {
      display: grid;
    }
  }
</style>

<div
  class="dubraes-contact-form"
  data-dubraes-contact-form
  data-api-url="{{ block.settings.api_url | escape }}"
>
  <div class="dubraes-contact-form__intro">
    <div class="dubraes-contact-form__visual">
      {% if block.settings.image != blank %}
        {{
          block.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '550, 800, 1100, 1400',
            sizes: '(min-width: 990px) 48vw, 100vw',
            alt: block.settings.heading
        }}
      {% else %}
        <img
          src="{{ 'custom-design-request-hero.png' | asset_url }}"
          alt="Custom sneaker idea with sketches and material samples"
          loading="lazy"
          width="1536"
          height="1024"
        >
      {% endif %}
    </div>

    <div class="dubraes-contact-form__intro-copy">
      {% if block.settings.eyebrow != blank %}
        <p class="dubraes-contact-form__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="dubraes-contact-form__heading">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="dubraes-contact-form__text">{{ block.settings.text }}</div>
      {% endif %}

      <ul class="dubraes-contact-form__steps">
        <li><span>01</span> Tell us what you are imagining</li>
        <li><span>02</span> Attach a sketch or inspiration image</li>
        <li><span>03</span> Our team will review your request</li>
      </ul>
    </div>
  </div>

  <div class="dubraes-contact-form__panel">
    <div class="dubraes-contact-form__panel-heading">
      <p class="dubraes-contact-form__eyebrow">Your custom request</p>
      <h3>Show us your idea</h3>
    </div>

    <form class="dubraes-contact-form__form" enctype="multipart/form-data">
      <div class="dubraes-contact-form__row">
        <div class="dubraes-contact-form__field">
          <label for="DubraesContactName-{{ block.id }}">Your name</label>
          <input id="DubraesContactName-{{ block.id }}" name="name" type="text" autocomplete="name" placeholder="Full name" required>
        </div>

        <div class="dubraes-contact-form__field">
          <label for="DubraesContactEmail-{{ block.id }}">Your email</label>
          <input id="DubraesContactEmail-{{ block.id }}" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        </div>
      </div>

      <div class="dubraes-contact-form__field">
        <label for="DubraesContactSubject-{{ block.id }}">What would you like us to create?</label>
        <input id="DubraesContactSubject-{{ block.id }}" name="subject" type="text" placeholder="Example: Custom red and black shoelace design">
      </div>

      <div class="dubraes-contact-form__field">
        <label for="DubraesContactMessage-{{ block.id }}">Describe your idea</label>
        <textarea id="DubraesContactMessage-{{ block.id }}" name="message" rows="6" placeholder="Tell us about the colors, materials, style, or the issue you had with the configurator." required></textarea>
      </div>

      <div class="dubraes-contact-form__field dubraes-contact-form__upload">
        <label for="DubraesContactImage-{{ block.id }}">Add an inspiration image or sketch</label>
        <input id="DubraesContactImage-{{ block.id }}" name="image" type="file" accept="image/jpeg,image/png,image/webp">
        <small>JPG, PNG, or WEBP. Maximum file size: 5MB.</small>
      </div>

      <div class="dubraes-contact-form__honeypot" aria-hidden="true">
        <label for="DubraesContactWebsite-{{ block.id }}">Website</label>
        <input id="DubraesContactWebsite-{{ block.id }}" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <div class="dubraes-contact-form__actions">
        <button class="dubraes-contact-form__button" type="submit">
          {{ block.settings.button_label }}
        </button>
        <p>We will review your idea and reply by email.</p>
      </div>

      <div class="dubraes-contact-form__status" data-dubraes-contact-status role="status" aria-live="polite"></div>
    </form>
  </div>
</div>

<script src="{{ 'dubraes-contact-form.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Custom design request",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Have something different in mind?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bring your own idea to Dubraes"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>If the Shoelaces or Dubraes configurator cannot create what you have in mind, send us your idea directly. Share the details and attach an image so our team can help bring it to life.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit my idea"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "API URL",
      "default": "https://shopify-app-dubraes.onrender.com/api/contact"
    }
  ]
}
{% endschema %}
